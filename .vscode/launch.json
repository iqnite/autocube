  "version": "0.2.0",
  "configurations": [
    {
      "name": "main",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/autocube_script.py",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}"
    },
    {
      "name": "Download and Run",
      "type": "ev3devBrowser",
      "request": "launch",
      "program": "/home/robot/${workspaceRootFolderName}/robot/main.py",
      "interactiveTerminal": false
    }
  ]
}
